# --- Telegram ---
TELEGRAM_BOT_TOKEN=123456789:your-telegram-bot-token
BOT_USERNAME=your_bot_username

# --- Voice provider (kept server-side only, never exposed to users) ---
CARTESIA_API_KEY=your-cartesia-api-key

# --- Database ---
# SQLite for development (default). For production, point this at Postgres, e.g.:
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname
DATABASE_URL=sqlite+aiosqlite:///./voicebot.db

# --- Admins (comma-separated Telegram user IDs) ---
ADMIN_IDS=

# --- Force-join gate (leave both blank to disable) ---
# The bot's own account must be an admin of this channel to check membership.
# Numeric chat id (e.g. -1001234567890) or @username.
REQUIRED_CHANNEL_ID=
# Link shown on the "Join Channel" button, e.g. https://t.me/yourchannel
REQUIRED_CHANNEL_INVITE_LINK=

# --- Economy ---
REFERRAL_REWARD=10
WELCOME_CREDITS=5
REFERRAL_QUALIFY_GENERATIONS=1
CREDITS_PER_CHARACTER=0.1
MIN_CHARGE_CREDITS=1
CLONE_CREDITS_COST=20

# --- Limits ---
MAX_TEXT_LENGTH=1000
MAX_CLONE_SAMPLE_SECONDS=300
MAX_CLONE_SAMPLE_MB=25
MAX_VOICES_PER_USER=10

# --- Branding ---
BRAND_NAME=EchoVerse AI

# --- Misc ---
REQUEST_TIMEOUT_SECONDS=60
BROADCAST_RATE_PER_SECOND=25
